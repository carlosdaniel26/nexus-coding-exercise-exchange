set shell := ["bash", "-uc"]

root := justfile_directory()
bin := "exercise-rs"

default:
    @just --list

build:
    cargo build

release:
    cargo build --release

check:
    cargo check

test:
    cargo test

run *args: (build)
    exec {{root}}/target/debug/{{bin}} {{args}}

debug *args: (build)
    exec gdb -q -tui -ex "break main" -ex run --args {{root}}/target/debug/{{bin}} {{args}}

clean:
    cargo clean
